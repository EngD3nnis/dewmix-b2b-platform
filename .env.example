# ============ DATABASE ============
DATABASE_URL="postgresql://dewmix:dewmix@localhost:5432/dewmix?schema=public"
DIRECT_URL="postgresql://dewmix:dewmix@localhost:5432/dewmix?schema=public"

# ============ REDIS ============
REDIS_URL="redis://localhost:6379"

# ============ SEARCH (TYPESENSE) ============
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="dewmix-typesense-dev-key"

# ============ STORAGE (S3 / MinIO local) ============
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="dewmix-images"
S3_ACCESS_KEY="dewmix"
S3_SECRET_KEY="dewmix-secret"
S3_PUBLIC_URL="http://localhost:9000/dewmix-images"

# ============ API ============
API_PORT="4000"
API_HOST="0.0.0.0"
NODE_ENV="development"

# ============ AUTH ============
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# ============ SMS (Africa's Talking — optional, for future use) ============
# Leave AT_API_KEY blank to use the console-logging fallback in dev.
AT_API_KEY=""
AT_USERNAME="sandbox"
AT_SENDER_ID="DEWMIX"

# ============ NOTIFICATIONS ============
# Fallback phone (intl format, no '+') for inquiry-received SMS when no admin
# user has a phone set in the database. Always notified in addition to any
# admin users with phones.
ADMIN_NOTIFICATION_PHONE="254787151516"
# Absolute URL used in SMS templates that link back into the admin UI.
PUBLIC_WEB_URL="http://localhost:3000"

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="254787151516"
NEXT_PUBLIC_CONTACT_PHONE="0787151516"
NEXT_PUBLIC_BUSINESS_ADDRESS="Kenol Road, Kenya"

# ============ OBSERVABILITY ============
SENTRY_DSN=""
LOG_LEVEL="debug"
