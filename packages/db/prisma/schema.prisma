// Dewmix Hardware — Prisma schema
// See ARCHITECTURE.md §3 for design rationale.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "metrics"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ IDENTITY ============

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
  SUPER_ADMIN
  WAREHOUSE_STAFF
  FINANCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id            String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email         String?    @unique
  phone         String?    @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  phoneVerified DateTime?
  lastLoginAt   DateTime?

  addresses   Address[]
  savedItems  SavedItem[]
  quotes      QuoteRequest[]
  permissions UserPermission[]
  supplier    Supplier?
  reviews     Review[]
  otpRequests OtpRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([phone])
  @@index([email])
  @@index([role, status])
}

model UserPermission {
  userId     String @db.Uuid
  permission String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
}

model OtpRequest {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String?  @db.Uuid
  phone     String
  codeHash  String
  purpose   String // "login" | "verify" | "reset"
  attempts  Int      @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// ============ CATALOG ============

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

model Category {
  id          String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  iconName    String?
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  path        String
  depth       Int        @default(0)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  specSchema  Json?
  metaTitle       String?
  metaDescription String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([path])
  @@index([slug, isActive])
}

model Brand {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug      String    @unique
  name      String
  logoUrl   String?
  isFeatured Boolean  @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug             String        @unique
  sku              String        @unique
  name             String
  shortDescription String?
  description      String?       @db.Text
  categoryId       String        @db.Uuid
  brandId          String?       @db.Uuid
  specs            Json          @default("{}")
  priceCents       Int
  compareAtCents   Int?
  currency         String        @default("KES") @db.VarChar(3)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  weightGrams      Int?
  lengthMm         Int?
  widthMm          Int?
  heightMm         Int?
  metaTitle        String?
  metaDescription  String?
  popularityScore  Float         @default(0)
  minOrderQty      Int           @default(1)

  category   Category         @relation(fields: [categoryId], references: [id])
  brand      Brand?           @relation(fields: [brandId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  inventory  Inventory[]
  reviews    Review[]
  savedBy    SavedItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, isFeatured])
  @@index([popularityScore(sort: Desc)])
  @@index([priceCents])
}

model ProductVariant {
  id         String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId  String  @db.Uuid
  sku        String  @unique
  name       String
  priceCents Int?
  attributes Json    @default("{}")

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId String  @db.Uuid
  url       String
  blurDataUrl String?
  alt       String?
  sortOrder Int     @default(0)
  width     Int?
  height    Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// ============ INVENTORY ============

model Warehouse {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  code      String  @unique
  address   String?
  city      String
  latitude  Float?
  longitude Float?
  isActive  Boolean @default(true)

  inventory Inventory[]
  createdAt DateTime @default(now())
}

model Inventory {
  id           String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId    String  @db.Uuid
  variantId    String? @db.Uuid
  warehouseId  String  @db.Uuid
  quantity     Int     @default(0)
  reserved     Int     @default(0)
  reorderLevel Int     @default(0)
  version      Int     @default(0)

  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([productId, variantId, warehouseId])
  @@index([warehouseId])
  @@index([quantity])
}

model Address {
  id         String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String? @db.Uuid
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String  @default("KE")
  latitude   Float?
  longitude  Float?
  isDefault  Boolean @default(false)

  user           User?   @relation(fields: [userId], references: [id])
}

// ============ ENGAGEMENT ============

model SavedItem {
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

enum QuoteStatus {
  PENDING
  RESPONDED
  ACCEPTED
  EXPIRED
  CANCELLED
}

model QuoteRequest {
  id              String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId          String?     @db.Uuid
  contactName     String
  contactPhone    String
  contactEmail    String?
  items           Json
  notes           String?
  status          QuoteStatus @default(PENDING)
  respondedAt     DateTime?
  responsePayload Json?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Review {
  id         String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId  String  @db.Uuid
  userId     String  @db.Uuid
  rating     Int
  title      String?
  body       String?
  isVerified Boolean @default(false)

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

// ============ SUPPLIERS ============

enum SupplierStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model Supplier {
  id           String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String         @unique @db.Uuid
  businessName String
  kraPin       String?
  status       SupplierStatus @default(PENDING_APPROVAL)
  commission   Float          @default(0.10)

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// ============ OBSERVABILITY ============

model AuditLog {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?  @db.Uuid
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  aggregate   String // "product" | "order" | etc
  aggregateId String    @db.Uuid
  eventType   String // "product.updated"
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

model Inquiry {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  referenceNumber String   @unique
  items           Json
  message         String   @db.Text
  status          String   @default("NEW")
  createdAt       DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Lightweight analytics event for inquiry/intent tracking.
/// Written from the storefront via sendBeacon — must be cheap to insert.
/// No FK back to Product so a hard-deleted product still leaves a count.
/// `kind` is a string (not enum) so the storefront can add new kinds
/// without a coordinated migration. Values currently in use:
///   - "WHATSAPP_INQUIRY"   single-product "Order via WhatsApp" tap
///   - "QUOTE_ADD"          product added to multi-item quote basket
///   - "QUOTE_SEND"         basket sent to WhatsApp (fired on /quote send)
///   - "PRODUCT_VIEW"       reserved; not yet wired
model ProductEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId String   @db.Uuid
  kind      String
  /// Daily-salted SHA-256 of the source IP. Lets us de-dupe burst clicks
  /// from the same person within a day without storing PII.
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}
