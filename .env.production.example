# ============================================================================
# Dewmix Hardware — PRODUCTION environment template
# Copy these into your hosting providers (Vercel for web, Render/Fly for API).
# DO NOT commit a filled-in version of this file.
# ============================================================================

NODE_ENV="production"

# ────────────────────────────────────────────────────────────────────────────
# DATABASE — from Neon, Supabase, or Railway Postgres dashboard
# Use the "pooled" connection for DATABASE_URL and the direct one for migrations.
# ────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASS@HOST/dewmix?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST/dewmix?sslmode=require"

# ────────────────────────────────────────────────────────────────────────────
# REDIS — from Upstash dashboard (or any managed Redis)
# Use rediss:// for TLS — Upstash defaults to it.
# ────────────────────────────────────────────────────────────────────────────
REDIS_URL="rediss://default:PASS@HOST:6379"

# ────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE — from Cloudflare R2 dashboard
# Recommended over MinIO/S3 for cost and zero egress fees.
# Create an R2 bucket called `dewmix-images` and an API token with R/W on it.
# ────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="dewmix-images"
S3_ACCESS_KEY="..."
S3_SECRET_KEY="..."
# Public URL is the custom domain you set on the bucket (or the r2.dev URL).
# Whatever this is, add the hostname to apps/web/next.config.mjs remotePatterns.
S3_PUBLIC_URL="https://images.dewmixhardware.co.ke"

# ────────────────────────────────────────────────────────────────────────────
# API
# ────────────────────────────────────────────────────────────────────────────
API_PORT="4000"
LOG_LEVEL="info"

# ────────────────────────────────────────────────────────────────────────────
# AUTH — generate a long random secret. NEVER use the .env.example placeholder.
# Quick generation:
#   openssl rand -base64 48
# ────────────────────────────────────────────────────────────────────────────
JWT_SECRET="REPLACE-WITH-OUTPUT-OF-OPENSSL-RAND-BASE64-48"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"
COOKIE_DOMAIN=".dewmixhardware.co.ke"   # leading dot so subdomains share it
COOKIE_SECURE="true"

# ────────────────────────────────────────────────────────────────────────────
# SMS — Africa's Talking production credentials
# Leave AT_API_KEY blank to fall back to console logging (no SMS will send).
# ────────────────────────────────────────────────────────────────────────────
AT_API_KEY="..."
AT_USERNAME="dewmix"
AT_SENDER_ID="DEWMIX"

# ────────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS — fallback phone for admin SMS when no admin users have phones
# ────────────────────────────────────────────────────────────────────────────
ADMIN_NOTIFICATION_PHONE="254787151516"
PUBLIC_WEB_URL="https://dewmixhardware.co.ke"

# ────────────────────────────────────────────────────────────────────────────
# SEED ONLY — used during the one-time `pnpm db:seed` run.
# Pick something the owner will remember. Delete after seeding.
# ────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=""

# ────────────────────────────────────────────────────────────────────────────
# FRONTEND (NEXT_PUBLIC_* — these are bundled into the browser, do not put
# secrets here). Set these in the Vercel dashboard.
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://api.dewmixhardware.co.ke"
NEXT_PUBLIC_SITE_URL="https://dewmixhardware.co.ke"
NEXT_PUBLIC_WHATSAPP_NUMBER="254787151516"
NEXT_PUBLIC_CONTACT_PHONE="0787151516"
NEXT_PUBLIC_BUSINESS_ADDRESS="Kenol Road, Kenya"

# ────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY (optional for first launch — set when ready)
# ────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=""
